!/tests/unit/test_sapolicy_decode_timing.py
!/tests/unit/test_viewer_config.py
!/tests/unit/test_taccap_camera.py

!/tests/unit/test_umi_dp_tianji.py
!/tests/unit/test_tianji_diff_ik.py
!/tests/unit/test_tianji_rtc.py
!/tests/integration/
/tests/integration/*
!/tests/integration/test_umi_tianji_process_decoding.py
!/tests/integration/test_tianji_rtc_process.py
!/tests/integration/test_viewer_offline.py

# Tianji embodiment migration and hardware-free component checks.
!/tests/unit/test_tianji_embodiment_layout.py
!/tests/unit/test_tianji_robot.py
