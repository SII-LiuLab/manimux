# Private embodiment SDKs and robot assets stay on the local installation.
/manimux/embodiments/**/sdk/
/manimux/embodiments/**/asset/
/manimux/embodiments/**/assets/
# Also exclude the pre-refactor locations and backup copies.
/manimux/assets/tianji/
/manimux/assets/end_effectors/umi_follower/

# YAM 的公开 MIT 模型随组件发布，保留重构前已跟踪的资源。
!/manimux/embodiments/arm/yam/assets/
!/manimux/embodiments/arm/yam/assets/**
!/tests/unit/test_yam_assembly.py
!/tests/unit/test_policy_adapter_configuration.py
!/tests/unit/test_station_entrypoints.py
!/tests/unit/test_tianji_local_bindings.py

# Hardware substitutes and fixtures are test-only; they are not runtime plugins.
!/tests/__init__.py
!/tests/conftest.py
!/tests/support/
!/tests/support/**
!/tests/fixtures/
!/tests/fixtures/**

# Test-source inclusion above must not include generated Python bytecode.
**/__pycache__/
*.py[cod]

# Local backup of the pre-refactor package tree; the active package is /manimux.
/src/
